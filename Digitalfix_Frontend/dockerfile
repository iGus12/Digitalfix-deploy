# Etapa 1: Construcción (Build) con Node.js
FROM node:18-alpine as build
WORKDIR /app

# Copiar archivos de dependencias e instalar
COPY package*.json ./
RUN npm install

# Copiar el resto del código fuente
COPY . .

# Recibir las variables de entorno desde el docker-compose.yml
ARG VITE_API_BASE_URL
ARG VITE_AZURE_CLIENT_ID
ARG VITE_AZURE_TENANT_ID
ARG VITE_AZURE_REDIRECT_URI
ARG VITE_AZURE_API_SCOPE

# Generar la versión estática de producción (carpeta 'dist')
RUN npm run build

# Etapa 2: Producción con Nginx
FROM nginx:alpine

# Copiar los archivos compilados desde la etapa anterior
COPY --from=build /app/dist /usr/share/nginx/html
a
# Exponer el puerto interno 80 que usa Nginx por defecto
EXPOSE 80

# Iniciar Nginx
CMD ["nginx", "-g", "daemon off;"]